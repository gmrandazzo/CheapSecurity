{
  "camera": {
    "device": 0,
    "width": 2560,
    "height": 1440,
    "fps": 15,
    "night_mode": false,
    "night_mode_strength": "normal",
    "night_device": null,
    "night_device_width": 1280,
    "night_device_height": 720,
    "night_device_fps": 15,
    "night_software_enhance": true,
    "night_mode_fps": 5,
    "night_mode_gain": 255,
    "night_mode_brightness": 200,
    "night_mode_contrast": 200
  },
  "motion": {
    "threshold": 25,
    "min_area": 2000,
    "blur_size": 21,
    "cooldown_seconds": 5,
    "scale": 0.25
  },
  "recording": {
    "dir": "./recordings",
    "max_duration_seconds": 60,
    "pre_buffer_seconds": 3,
    "codec": "MJPG",
    "extension": ".avi"
  },
  "notifications": {
    "enabled": false,
    "smtp": {
      "server": "smtp.gmail.com",
      "port": 465,
      "username": "you@gmail.com",
      "password": "your_gmail_app_password",
      "use_tls": true
    },
    "from": "you@gmail.com",
    "to": [
      "you@gmail.com"
    ],
    "subject": "CheapSecurity Motion Alert",
    "min_interval_minutes": 5
  },
  "telegram": {
    "enabled": false,
    "bot_token": "123456789:YOUR_BOT_TOKEN_HERE",
    "chat_id": "YOUR_CHAT_ID_HERE",
    "send_video": true,
    "min_interval_minutes": 5,
    "poll_commands": true
  },
  "cloud": {
    "google_drive": {
      "enabled": false,
      "client_id": "YOUR_GDRIVE_CLIENT_ID",
      "client_secret": "YOUR_GDRIVE_CLIENT_SECRET",
      "refresh_token": "YOUR_GDRIVE_REFRESH_TOKEN",
      "folder_id": "OPTIONAL_GDRIVE_FOLDER_ID"
    },
    "onedrive": {
      "enabled": false,
      "client_id": "YOUR_ONEDRIVE_CLIENT_ID",
      "client_secret": "YOUR_ONEDRIVE_CLIENT_SECRET",
      "refresh_token": "YOUR_ONEDRIVE_REFRESH_TOKEN",
      "folder_path": "CheapSecurity"
    }
  },
  "encryption": {
    "passphrase": "YOUR_SECRET_AES_PASSPHRASE",
    "telegram": false,
    "google_drive": false,
    "onedrive": false
  },
  "rtsp": {
    "enabled": false,
    "port": 8554,
    "path": "live",
    "width": 1280,
    "height": 720,
    "fps": 15,
    "mediamtx_binary": "/usr/local/bin/mediamtx",
    "mediamtx_config": "rtsp/mediamtx.yml"
  },
  "web": {
    "host": "0.0.0.0",
    "port": 5000,
    "stream_scale": 0.5,
    "auth": {
      "enabled": false,
      "username": "admin",
      "password": "changeme"
    }
  },
  "storage": {
    "max_age_days": 3,
    "max_size_gb": 10,
    "cleanup_interval_minutes": 60,
    "delete_old_on_startup": false,
    "emergency_free_space_gb": 1.0,
    "emergency_delete_count": 4
  }
}
